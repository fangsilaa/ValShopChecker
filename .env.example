# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# The server the bot runs in (right-click server > Copy Server ID, needs Developer Mode)
DISCORD_GUILD_ID=

# 64 hex chars used to encrypt Riot cookies/tokens at rest. Generate with: npm run gen-key
# If you change this, everyone has to /login again.
ENC_KEY=

# Optional: channel for wishlist alerts. If empty, alerts are sent by DM.
ALERT_CHANNEL_ID=
# Optional: fallback region if auto-detection fails (na, eu, ap, kr, latam, br)
DEFAULT_REGION=na
# Optional: where the SQLite database lives
DB_PATH=data/bot.sqlite
