{
  "name": "valshoptracker",
  "version": "0.1.0",
  "private": true,
  "description": "Private Discord bot that shows each linked user's Valorant daily shop, bundles and night market, with wishlist alerts.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "check-now": "tsx src/index.ts --check-now",
    "gen-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
